{
    "name": "cronradar/laravel",
    "description": "Detect missed and failed Laravel scheduled tasks with automatic schedule discovery and execution tracking.",
    "keywords": ["laravel", "scheduler", "scheduled-tasks", "monitoring", "missed-jobs", "failed-jobs", "artisan"],
    "homepage": "https://cronradar.com/laravel",
    "license": "proprietary",
    "authors": [
        {
            "name": "CronRadar",
            "email": "support@cronradar.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "cronradar/php": "^0.0.6"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CronRadar\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CronRadar\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CronRadar\\Laravel\\CronRadarServiceProvider"
            ],
            "aliases": {
                "CronRadar": "CronRadar\\Laravel\\CronRadarFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
